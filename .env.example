# Copy to .env (gitignored) on the deploy host. Never commit real secrets.
SESSION_SECRET=replace-with-openssl-rand-hex-32
# Optional: load secret from a file instead (overrides empty SESSION_SECRET).
# SESSION_SECRET_FILE=/path/to/benito/.session_secret
BENITO_PORT=8080
# Bare binary / scripts/run-server.sh: keep loopback and front it with Tailscale Serve
# or a reverse proxy. Docker compose sets 0.0.0.0 inside the container itself.
BIND_ADDR=127.0.0.1:8080
# Let phones on your home Wi-Fi in without Tailscale (babysitters, grandparents): add a LAN
# listener. Loopback keeps serving Tailscale Serve; the LAN port is plain HTTP (see SECURITY.md).
# BIND_ADDR=127.0.0.1:8080,0.0.0.0:8081
# URLs written into invites, in the order a joining phone should try them (LAN first).
# The inviter's own server URL is always included too.
# BENITO_PUBLIC_URLS=http://192.168.1.20:8081,https://your-host.your-tailnet.ts.net
# When bound beyond loopback the server advertises _benito._tcp over Bonjour so the app's
# onboarding finds it. Rename it, or set BENITO_BONJOUR=0 to turn it off.
# BENITO_BONJOUR_NAME=Benito
# BENITO_BONJOUR=0
RUST_LOG=benito_server=info,tower_http=info

# ActivityKit Live Activity push (optional). Leave unset → server no-ops pushes; WebSocket still works.
# Place the AuthKey_XXXXXX.p8 on the host (never commit it). Topic must end with .push-type.liveactivity.
# APNS_KEY_PATH=/path/to/AuthKey_XXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=ABCDE12345
# APNS_TOPIC=com.example.benito.push-type.liveactivity

# SQLite file path; defaults to data.db relative to the working directory.
# DATABASE_PATH=data.db
# Used only when DATABASE_PATH is unset; a leading sqlite: is stripped.
# DATABASE_URL=sqlite:data.db
# Explicit env file checked before .env, ../.env and binary-relative paths; set in the real environment, not .env itself.
# BENITO_ENV_FILE=/path/to/benito/.env
